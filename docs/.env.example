# Mostro Web Local
# Copy to .env.local and fill the PUBLIC Mostro instance configuration.
# Never put mnemonic, nsec or ADMIN_NSEC here.

MOSTRO_PUBKEY=
RELAYS=

# Optional path if mostro-cli is not in PATH:
# MOSTRO_CLI_PATH=/home/you/.cargo/bin/mostro-cli

# Optional only if the selected Mostro instance requires it:
# POW=

# Optional Mostro Mobile push wake-up endpoint:
# MOSTRO_PUSH_SERVER_URL=https://mostro-push-server.fly.dev

# Optional mostro-cli database location (chat opens it read-only):
# MOSTRO_CLI_DB_PATH=/home/you/.mcli/mcli.db

# Local-only server
HOSTNAME=127.0.0.1
PORT=3000
